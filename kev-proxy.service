[Unit]
Description=reasoning-gate effort decision proxy (OpenAI-compatible middle layer; julia cascade)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/kev-proxy
# Decision cascade: julia (primary) -> d3-lite (standby) -> passthrough.
# KEV_URL kept empty disables the legacy KEV-4B path; set it to re-enable.
Environment=KEV_URL=
Environment=JULIA_URL=http://192.168.1.30:8906/v1/systemone
Environment=JULIA_TIMEOUT=5
Environment=DECIDER_URL=http://192.168.1.20:8731/v1/systemone
Environment=DECIDER_MODEL=d3-lite
Environment=DECIDER_TIMEOUT=10
Environment=BACKEND_CHAT=http://192.168.1.20:8731/v1/chat/completions
Environment=BACKEND_RESP=http://192.168.1.20:8731/v1/responses
Environment=BACKEND_MODEL=halogen-qwen3.8-flash-next
Environment=KEV_LOG=%h/.hermes/kev-proxy/decisions.jsonl
Environment=KEV_PROXY_PORT=8910
ExecStart=/usr/bin/python3 %h/Projects/kev-proxy/kev_proxy.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
