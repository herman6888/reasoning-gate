# kev-proxy 配置示例 — 复制为 .env 或直接 export
# Kev-4B 决策服务（暴露 /v1/systemone）
KEV_URL=http://192.168.1.10:8905/v1/systemone

# 推理后端（任何接受 reasoning_effort 的 OpenAI 兼容服务）
BACKEND_CHAT=http://192.168.1.20:8731/v1/chat/completions
BACKEND_RESP=http://192.168.1.20:8731/v1/responses
BACKEND_MODEL=halogen-qwen3.8-flash-next

# 无客户端 effort 时的兜底
KEV_DEFAULT_EFFORT=medium

# 决策审计日志
KEV_LOG=~/.hermes/kev-proxy/decisions.jsonl

# 代理监听端口
KEV_PROXY_PORT=8910

# lease 有效代数上限（夜间实测 10 太激进）
KEV_LEASE_CAP=5

# 判 none（零思考）所需的最低置信度
KEV_NONE_MIN_CONF=0.55
